{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xuanling-tradecore:contract:merge-manifest:2",
  "title": "TradeCore MergeManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated",
    "sealed",
    "previous_manifest_hash",
    "shards",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "generated": {"type": "boolean"},
    "sealed": {"type": "boolean"},
    "previous_manifest_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "shard_id",
          "journal_epoch",
          "profile_hash",
          "frame_hash",
          "contiguous_position",
          "capacity",
          "route_directory_digest",
          "writer_identity_digest",
          "generated",
          "sealed"
        ],
        "properties": {
          "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "shard_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "journal_epoch": {"type": "integer", "minimum": 1},
          "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "frame_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "contiguous_position": {"type": "integer", "minimum": 0},
          "capacity": {"type": "integer", "minimum": 1},
          "route_directory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "writer_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "generated": {"type": "boolean"},
          "sealed": {"type": "boolean"}
        }
      }
    }
  }
}
