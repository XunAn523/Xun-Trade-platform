{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_version", "venue_id", "fingerprint", "effective_interval", "owner", "evidence", "field_mappings", "order_routes", "identity", "capabilities", "recovery"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "manifest_version": {"type": "integer", "minimum": 1},
    "venue_id": {"type": "string", "minLength": 1},
    "fingerprint": {"$ref": "#/$defs/fingerprint"},
    "effective_interval": {"$ref": "#/$defs/effectiveInterval"},
    "owner": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "field_mappings": {"$ref": "#/$defs/fieldMappings"},
    "order_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/orderRoute"}},
    "identity": {"$ref": "#/$defs/identity"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "recovery": {"$ref": "#/$defs/recovery"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint": {"type": "object", "additionalProperties": false, "required": ["adapter_id", "adapter_version", "sdk_version", "adapter_package_hash", "sdk_binary_hash", "binding_package_hash"], "properties": {"adapter_id": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "sdk_version": {"type": "string", "minLength": 1}, "adapter_package_hash": {"$ref": "#/$defs/sha256"}, "sdk_binary_hash": {"$ref": "#/$defs/sha256"}, "binding_package_hash": {"$ref": "#/$defs/sha256"}}},
    "effectiveInterval": {"type": "object", "additionalProperties": false, "required": ["not_before_unix_s"], "properties": {"not_before_unix_s": {"type": "integer", "minimum": 0}, "not_after_unix_s": {"type": ["integer", "null"], "minimum": 0}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source_reference", "fixture_id", "test_id", "owner"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "source_reference": {"type": "string", "minLength": 1}, "fixture_id": {"type": "string", "minLength": 1}, "test_id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}}},
    "enumMapping": {"type": "object", "additionalProperties": false, "required": ["domain_value", "venue_value", "evidence_ids"], "properties": {"domain_value": {"type": "string", "minLength": 1}, "venue_value": {"type": "integer", "minimum": 0}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "fieldMappings": {"type": "object", "additionalProperties": false, "required": ["market", "side", "price_type", "business_type"], "properties": {"market": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enumMapping"}}, "side": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enumMapping"}}, "price_type": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enumMapping"}}, "business_type": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/enumMapping"}}}},
    "orderRoute": {"type": "object", "additionalProperties": false, "required": ["business_type", "side", "required_capabilities", "evidence_ids"], "properties": {"business_type": {"type": "string", "minLength": 1}, "side": {"type": "string", "minLength": 1}, "required_capabilities": {"type": "array", "minItems": 1, "items": {"enum": ["CASH", "MARGIN_BUY", "SHORT_SELL"]}}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["client_order_ref_field", "client_order_ref_format", "venue_order_id_field", "venue_order_id_format", "venue_cancel_id_field", "venue_cancel_id_format", "adapter_client_scope_field", "adapter_client_scope_format", "evidence_ids"], "properties": {"client_order_ref_field": {"type": "string", "minLength": 1}, "client_order_ref_format": {"type": "string", "minLength": 1}, "venue_order_id_field": {"type": "string", "minLength": 1}, "venue_order_id_format": {"type": "string", "minLength": 1}, "venue_cancel_id_field": {"type": "string", "minLength": 1}, "venue_cancel_id_format": {"type": "string", "minLength": 1}, "adapter_client_scope_field": {"type": "string", "minLength": 1}, "adapter_client_scope_format": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["capability_profile_id", "version", "venue_id", "supports_cash", "supports_margin_buy", "supports_short_sell", "supports_pagination", "supports_public_stream_replay", "echoes_client_order_ref", "has_stable_venue_order_id", "has_stable_trade_id", "supports_complete_recovery_queries", "supports_negative_confirmation"], "properties": {"capability_profile_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "venue_id": {"type": "string", "minLength": 1}, "supports_cash": {"type": "boolean"}, "supports_margin_buy": {"type": "boolean"}, "supports_short_sell": {"type": "boolean"}, "supports_pagination": {"type": "boolean"}, "supports_public_stream_replay": {"type": "boolean"}, "echoes_client_order_ref": {"type": "boolean"}, "has_stable_venue_order_id": {"type": "boolean"}, "has_stable_trade_id": {"type": "boolean"}, "supports_complete_recovery_queries": {"type": "boolean"}, "supports_negative_confirmation": {"type": "boolean"}, "supports_paper_matching": {"type": "boolean"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["supports_order_query", "supports_trade_query", "supports_working_order_query", "supports_asset_query", "supports_position_query", "automatic_recovery_eligible", "evidence_ids"], "properties": {"supports_order_query": {"type": "boolean"}, "supports_trade_query": {"type": "boolean"}, "supports_working_order_query": {"type": "boolean"}, "supports_asset_query": {"type": "boolean"}, "supports_position_query": {"type": "boolean"}, "automatic_recovery_eligible": {"type": "boolean"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
  }
}
