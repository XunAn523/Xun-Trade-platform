{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emt-gateway:schema:mutation-fixture:1",
  "title": "Credential-free EMT mutation fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "safety", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 4096},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armed", "instructions"],
      "properties": {
        "armed": {"type": "boolean"},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "profile",
        "enabled",
        "request",
        "rate_limit_per_second",
        "reconciliation_query",
        "notes"
      ],
      "properties": {
        "api": {"type": "string", "minLength": 1},
        "profile": {"enum": ["ordinary", "credit", "option"]},
        "enabled": {"type": "boolean"},
        "request": {"$ref": "#/$defs/request"},
        "rate_limit_per_second": {"type": "integer", "minimum": 0},
        "reconciliation_query": {"type": "string", "maxLength": 256},
        "notes": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "request": {
      "type": "object",
      "propertyNames": {
        "not": {
          "pattern": "(?i)^(account|address|endpoint|fund_account|host|password|port|secret|token)$"
        }
      },
      "additionalProperties": {"$ref": "#/$defs/json_value"}
    },
    "json_value": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/json_value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}
      ]
    }
  }
}
