{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradeCore OMS load gate result v1",
  "type": "object",
  "required": ["schema", "generated_at_utc", "git_revision", "status", "workloads"],
  "properties": {
    "schema": {"const": "TradeCoreOmsLoadGateResultV1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "git_revision": {"type": "string"},
    "base_urls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "fact_tps_target": {"type": "integer", "minimum": 1},
    "snapshot_qps_target": {"type": "integer", "minimum": 1},
    "preparations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workload", "status"],
        "properties": {
          "workload": {"type": "string"},
          "status": {"enum": ["RESET", "CAPTURED", "FAIL"]},
          "evidence": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workload", "exit_code", "summary"],
        "properties": {
          "workload": {"type": "string"},
          "exit_code": {"type": "integer"},
          "summary": {"type": ["string", "null"]}
        }
      }
    }
  }
}
